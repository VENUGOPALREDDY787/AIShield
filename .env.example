# =============================================================================
# AIShield Security Debt — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` before starting containers:
#   cp .env.example .env
#
# SECURITY NOTICE:
# - NEVER commit `.env` containing real keys or credentials to version control.
# - All secrets must be securely supplied via environment variables or secret vaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime & Logging Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
# Options: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# API Service Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# 32+ character API Key for authenticating REST API requests
API_KEY=change-this-to-a-secure-random-32-char-key-in-prod
# Set SKIP_AUTH=true ONLY for local development bypass
SKIP_AUTH=false
# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
API_BODY_LIMIT=1mb

# -----------------------------------------------------------------------------
# Frontend Dashboard Configuration
# -----------------------------------------------------------------------------
WEB_PORT=8080
DASHBOARD_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_TITLE=AIShield Debt

# -----------------------------------------------------------------------------
# MongoDB Core Data Store
# -----------------------------------------------------------------------------
MONGO_ROOT_USERNAME=aishield_admin
MONGO_ROOT_PASSWORD=replace_with_strong_password_123!
MONGO_DATABASE=aishield
MONGO_URI=mongodb://aishield_admin:replace_with_strong_password_123!@mongo:27017/aishield?authSource=admin
MONGO_POOL_SIZE=10

# -----------------------------------------------------------------------------
# Redis Queue & Caching Layer
# -----------------------------------------------------------------------------
REDIS_URL=redis://:replace_with_redis_password_123!@redis:6379
REDIS_PASSWORD=replace_with_redis_password_123!
QUEUE_PREFIX=aishield
QUEUE_CONCURRENCY=4
QUEUE_REMOVE_ON_COMPLETE=500
QUEUE_REMOVE_ON_FAIL=1000

# -----------------------------------------------------------------------------
# Scanner Orchestrator Configuration
# -----------------------------------------------------------------------------
# Options: 'docker' (spawns isolated containers) | 'local' (host execution)
SCANNER_RUNNER=docker
SCANNER_WORK_DIR=/tmp/aishield-scans
SCANNER_TIMEOUT_MS=120000

# Scanner Container Image Digests / Tags
SCANNER_IMAGE_SEMGREP=aishield/semgrep-scanner:0.1.0
SCANNER_IMAGE_GITLEAKS=aishield/gitleaks-scanner:0.1.0
SCANNER_IMAGE_DEPENDENCY=aishield/dependency-scanner:0.1.0
SCANNER_IMAGE_AI_ANALYZER=aishield/ai-analyzer:0.1.0

# -----------------------------------------------------------------------------
# AI Contextual Risk Analyzer (LLM Provider)
# -----------------------------------------------------------------------------
# Options: 'gemini' | 'openai' | 'mock'
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# GitHub Integration & Action Reporting
# -----------------------------------------------------------------------------
# GitHub Personal Access Token or App Installation Token (for PR comments & checks)
GITHUB_TOKEN=
FAIL_ON_CRITICAL=true
FAIL_ON_HIGH=false
FAIL_ON_POLICY_FAIL=true

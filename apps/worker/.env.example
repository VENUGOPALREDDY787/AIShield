NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=aishield-worker

MONGO_URI=mongodb://127.0.0.1:27017/aishield
MONGO_POOL_SIZE=10

REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
REDIS_TLS=false

QUEUE_PREFIX=aishield
QUEUE_CONCURRENCY=2

SCANNER_RUNNER=docker
SCANNER_WORK_DIR=/tmp/aishield-scans
SCANNER_TIMEOUT_MS=300000

# =============================================================================
# AIShield Debt — API service (local development)
# =============================================================================
# Copy to `.env`:   cp apps/api/.env.example apps/api/.env
# `.env` is git-ignored. Placeholders only — never commit real credentials.
# From the repo root, `docker compose` uses the top-level .env instead.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGINS=http://localhost:5173
API_BODY_LIMIT=1mb

# Point at the compose services when running in Docker, at localhost otherwise.
MONGO_URI=mongodb://aishield:REPLACE_ME@localhost:27017/aishield?authSource=admin
MONGO_POOL_SIZE=10

REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=aishield
QUEUE_CONCURRENCY=4
QUEUE_REMOVE_ON_COMPLETE=500
QUEUE_REMOVE_ON_FAIL=1000
